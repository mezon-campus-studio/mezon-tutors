<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mezonly.caddy</string>
	<key>UserName</key>
	<string>__USER__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/mezon-tutors/tools/caddy</string>
		<string>run</string>
		<string>--config</string>
		<string>__HOME__/mezon-tutors/deploy/Caddyfile</string>
		<string>--adapter</string>
		<string>caddyfile</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__/mezon-tutors</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>XDG_DATA_HOME</key>
		<string>__HOME__/mezon-tutors-data/caddy</string>
		<key>XDG_CONFIG_HOME</key>
		<string>__HOME__/mezon-tutors-data/caddy</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/mezon-tutors-data/logs/caddy.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/mezon-tutors-data/logs/caddy.log</string>
</dict>
</plist>
